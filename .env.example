# Copy to .env for local use (cp .env.example .env). On the hosting provider,
# set these as environment variables instead. Never commit .env.

# --- Required ---
# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=
# Long random secret: your master key for dashboards, reports and invites.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# Public URL of this server, used in demo, form and review links (no trailing slash)
PUBLIC_URL=http://localhost:3000

# --- Storage (production: point both to a persistent disk) ---
DATA_DIR=./data
CLIENTS_DIR=./clients

# --- n8n webhooks (paste the Production URL of each Webhook node) ---
# Bookings, leads and urgent alerts from every client
WEBHOOK_URL=
# Onboarding steps: submitted, ready_for_review, changes_requested, live
ONBOARDING_WEBHOOK_URL=
# Your email: receives the alerts of demo clients (they have no owner email)
ALERTS_FALLBACK_EMAIL=

# --- Prospecting ---
OUTSCRAPER_API_KEY=

# --- Optional ---
# PORT=3000
# MODEL=claude-opus-5-5
# EFFORT=low
# PROMPT_CACHE_TTL=1h   (how long the bot's fixed instructions stay cached; "5m" for clients with constant traffic)
# REPORT_WEBHOOK_URL=   (only for `npm run report -- --send`; n8n's schedule flow doesn't need it)
